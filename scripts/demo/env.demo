# Demo-only environment: points hsctl at the local demo server. No credentials here.
#
#   source scripts/demo/env.demo
#
# The base URL is not Hostaway's own, which is the whole reason every command
# banners SANDBOX in front of the demo: the judgement is made from the URL alone
# and never from a flag (ADR 0004 in docs/adr/).
export HOSTAWAY_API_BASE_URL=http://127.0.0.1:8765/v1
export HOSTAWAY_ACCOUNT_ID=424242
export HOSTAWAY_SECRET_KEY=demo-not-a-secret

# A demo must not cache a token for an invented account in a real operator's
# cache file, nor read a real operator's house defaults while it runs.
unset HSCTL_TOKEN_CACHE
unset HSCTL_CONFIG
